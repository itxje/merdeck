{
  "name": "merdeck",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": "24.20.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun scripts/build.ts",
    "start": "bun dist/index.js",
    "dev": "bun scripts/dev.ts api",
    "dev:bare": "bun --watch src/index.ts",
    "check": "bun scripts/check.ts",
    "check:files": "bun scripts/check-files.ts",
    "check:storage": "bun scripts/check-storage.ts",
    "test:e2e": "bun scripts/test-e2e.ts",
    "compile": "bun scripts/compile.ts",
    "lint:workflows": "bun scripts/verify-workflows.ts",
    "test:release": "bun scripts/release/test.ts",
    "check:ci": "bun scripts/check-ci.ts"
  },
  "dependencies": {
    "hono": "4.13.7",
    "mdast-util-from-markdown": "2.0.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@nsio/nsl": "0.1.7",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.1",
    "eslint": "10.10.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3"
  }
}
