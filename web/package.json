{
  "name": "merdeck-web",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "bun ../scripts/dev.ts web",
    "dev:bare": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config src/test/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "dompurify": "3.4.15",
    "lucide-react": "1.42.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.4",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@eslint-react/eslint-plugin": "5.19.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-refresh": "0.5.6",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
