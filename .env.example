# Required: explicitly choose an absolute directory; no working-directory fallback.
# Set the existing project directory directly; no automatic copy or relocation.
# Admission requires matching Linux overlay or evidenced ext4 descriptor/type/device metadata.
# Hosted ext4/Linux x64 source/executable acceptance passed; verify your actual storage.
# Unsupported storage remains readable. See README for verification and save limitations.
MERDECK_ROOT=
# Optional: 32–256 random printable non-space ASCII characters; the browser asks for it before opening the project.
# Use a private editor/input; never print/log it, commit it, or put it in URLs/VITE_*.
# Empty runs with open access: anyone who can reach the service can read, change, move and delete its diagram files.
# Other local users and anything forwarded to the port can reach a loopback service too; set a token on shared machines.
MERDECK_TOKEN=
# Without a token, startup requires MERDECK_HOST and every allowed origin on loopback (127.0.0.0/8, ::1 or localhost).
# Set true only to deliberately allow open access beyond loopback; it cannot be combined with MERDECK_TOKEN.
# MERDECK_OPEN_ACCESS=true
MERDECK_HOST=127.0.0.1
PORT=8787
NODE_ENV=production
# Comma-separated exact http(s) origins, without paths or trailing slashes.
# Empty defaults to the configured host and port; explicitly set the browser origin.
# For nsl development, leave empty for discovery or set the discovered nsl origin.
MERDECK_ALLOWED_ORIGINS=
# auto enables Secure for HTTPS origins; true requires HTTPS. false is not supported.
# TLS proxies must preserve Host; forwarded headers are ignored. Do not mix HTTP/HTTPS.
MERDECK_COOKIE_SECURE=auto
# Production/bare mode uses /api. Only the development nsl launcher uses stripped.
MERDECK_API_MODE=prefixed
MERDECK_MAX_FILE_BYTES=1048576
MERDECK_MAX_TREE_ENTRIES=1000
MERDECK_MAX_TREE_DEPTH=16
MERDECK_MAX_BLOCKS=100
MERDECK_POLL_INTERVAL_MS=3000
# With a token, sessions are signed with a key derived from the token and root and survive restarts until they expire.
# Changing MERDECK_TOKEN signs every browser out. MERDECK_MAX_SESSIONS bounds sessions issued by one running process.
MERDECK_SESSION_TTL_SECONDS=3600
MERDECK_MAX_SESSIONS=100
# Optional nsl name override; empty should be omitted rather than exported.
# MERDECK_DEV_NAME=merdeck-local
