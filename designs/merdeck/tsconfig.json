{
  "extends": "../../web/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "../../web/src/*"
      ],
      "react": [
        "../../web/node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "../../web/node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "../../web/node_modules/@types/react-dom/*"
      ],
      "*": [
        "../../web/node_modules/*"
      ],
      "vite": [
        "../../web/node_modules/vite/dist/node/index.d.ts"
      ],
      "@tailwindcss/vite": [
        "../../web/node_modules/@tailwindcss/vite/dist/index.d.mts"
      ]
    },
    "typeRoots": [
      "../../node_modules/@types",
      "../../web/node_modules/@types"
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
